<?xml version="1.0" encoding="utf-8"?>
<!-- Green header with rounded bottom corners. Same gradient as the Welcome header: light green top-left, deep green bottom-right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="315"
        android:centerColor="@color/green"
        android:endColor="@color/welcome_hero_end"
        android:startColor="@color/welcome_hero_start" />
    <corners android:bottomLeftRadius="36dp" android:bottomRightRadius="36dp" />
</shape>
