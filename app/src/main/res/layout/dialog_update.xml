<?xml version="1.0" encoding="utf-8"?>
<!-- "Update ViewGrow" pop-up: shown when Google Play has a newer version (UpdateCheck.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="22dp"
    android:paddingEnd="22dp"
    android:paddingBottom="22dp">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_logo_clip"
        android:clipToOutline="true"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/viewgrow_logo" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:tag="extrabold"
        android:text="Update ViewGrow"
        android:textColor="@color/dark"
        android:textSize="20sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="A new version is ready. Update to keep saving your contacts and getting alerts."
        android:textColor="@color/text2"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/update_now"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_pill_fill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:tag="semibold"
        android:text="Update on Google Play"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/update_later"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="46dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:tag="semibold"
        android:text="Later"
        android:textColor="@color/green_text"
        android:textSize="15sp" />
</LinearLayout>
