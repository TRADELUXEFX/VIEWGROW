<?xml version="1.0" encoding="utf-8"?>
<!-- Account deleted page (StopFragment, kind "deleted"), design A: one calm page, same as the website.
     Person icon with a red ×, "Account deleted", the number, a card with two rows (what was removed, how to come back),
     then "Message the admin" and "Back to start" at the bottom. The top block has id "hero" only so MainActivity
     pads it below the status bar; it has no colour of its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <FrameLayout
                android:layout_width="100dp"
                android:layout_height="100dp">
                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_deleted_icon"
                    android:contentDescription="@null"
                    android:padding="24dp"
                    android:src="@drawable/ic_user_plain"
                    android:tint="@color/text2" />
                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/bg_deleted_x"
                    android:contentDescription="@null"
                    android:padding="10dp"
                    android:src="@drawable/ic_close"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:tag="extrabold"
                android:text="Account deleted"
                android:textColor="@color/dark"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/stop_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_num_chip"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:tag="medium"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_rp_icon_sq"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_trash"
                        android:tint="@color/text2" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="semibold"
                            android:text="Everything was removed"
                            android:textColor="@color/dark"
                            android:textSize="14.5sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Your name, history and verified days are gone for good."
                            android:textColor="@color/text2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp">
                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_rp_icon_sq"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_door"
                        android:tint="@color/green_text" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:tag="semibold"
                            android:text="Want to come back?"
                            android:textColor="@color/dark"
                            android:textSize="14.5sp" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:lineSpacingExtra="2dp"
                            android:text="Ask the admin to let your number back in. You start again as a new member."
                            android:textColor="@color/text2"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_admin"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Message the admin"
            app:icon="@drawable/ic_chat"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconSize="20dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_back"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Back to start"
            android:textColor="@color/text"
            app:backgroundTint="@android:color/transparent"
            app:rippleColor="@color/seg_track" />
    </LinearLayout>
</LinearLayout>
