<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <include layout="@layout/part_header_user" />

    <!-- Nothing below the header shows until the database has answered: the ring turns first. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ImageView
        android:id="@+id/home_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="60dp"
        android:importantForAccessibility="no" />

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        android:scrollbars="none"
        android:visibility="invisible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Contacts received: the number on the left, the limit gauge on the right. -->
            <LinearLayout
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="18dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contacts received"
                        android:textColor="@color/text2"
                        android:textSize="13.5sp" />
                    <TextView
                        android:id="@+id/stat_received"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="extrabold"
                        android:text="0"
                        android:textColor="@color/dark"
                        android:textSize="36sp" />
                </LinearLayout>
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="58dp">
                    <com.viewgrow.app.GaugeView
                        android:id="@+id/gauge"
                        android:layout_width="96dp"
                        android:layout_height="96dp" />
                    <TextView
                        android:id="@+id/gauge_pct"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:gravity="center"
                        android:tag="bold"
                        android:text="0%"
                        android:textColor="@color/green_text"
                        android:textSize="11sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Countdown to the next release: words on the left, the time on the right. -->
            <LinearLayout
                android:id="@+id/countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_countdown"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="16dp"
                android:paddingEnd="18dp"
                android:paddingBottom="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Next contacts in"
                        android:textColor="@color/text2"
                        android:textSize="13.5sp" />

                </LinearLayout>
                <TextView
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="extrabold"
                    android:text="--:--:--"
                    android:textColor="@color/green_text"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Everything that depends on the state is added here by HomeFragment -->
            <LinearLayout
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>
</LinearLayout>
