<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <include layout="@layout/part_header_user" />

    <!-- Nothing below the header shows until the database has answered: the ring turns first. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <!-- Loading bar: a green stretch slides along the track until the database answers. -->
    <FrameLayout
        android:id="@+id/home_loading"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_gravity="top"
        android:layout_marginStart="18dp"
        android:layout_marginTop="22dp"
        android:layout_marginEnd="18dp"
        android:background="@drawable/bg_load_track"
        android:clipToOutline="true"
        android:importantForAccessibility="no">
        <View
            android:id="@+id/home_loading_fill"
            android:layout_width="110dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_load_fill" />
    </FrameLayout>

    <ScrollView
        android:id="@+id/home_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        android:scrollbars="none"
        android:visibility="invisible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Not verified members see their warning here instead of the countdown. -->
            <LinearLayout
                android:id="@+id/top_slot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Contacts received: the main card: label and number on the left, gauge on the right -->
            <LinearLayout
                android:id="@+id/stat_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                                android:background="@drawable/bg_stat_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="20dp"
                android:paddingEnd="18dp"
                android:paddingBottom="20dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Contacts received"
                        android:textColor="@color/text2"
                        android:textSize="15sp" />
                    <TextView
                        android:id="@+id/stat_received"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:tag="bold"
                        android:text="0"
                        android:textColor="@color/dark"
                        android:textSize="46sp" />
                </LinearLayout>
                <com.viewgrow.app.GaugeView
                    android:id="@+id/stat_gauge"
                    android:layout_width="120dp"
                    android:layout_height="70dp"
                    android:importantForAccessibility="no" />
            </LinearLayout>

            <!-- Countdown to the next release: one small row under the contacts card -->
            <LinearLayout
                android:id="@+id/countdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_countdown"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="12dp"
                android:paddingEnd="18dp"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Get new contacts in"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="extrabold"
                    android:text="--:--:--"
                    android:textColor="@color/green_text"
                    android:textSize="24sp" />
            </LinearLayout>

            <!-- Everything that depends on the state is added here by HomeFragment -->
            <LinearLayout
                android:id="@+id/body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>
</LinearLayout>
