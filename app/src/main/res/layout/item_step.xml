<?xml version="1.0" encoding="utf-8"?>
<!-- One step card on the Welcome screen: number, title, line of text, icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/step_num"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:background="@drawable/bg_badge_white"
        android:gravity="center"
        android:tag="extrabold"
        android:textColor="@color/green_dark"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="bold"
            android:textColor="@color/white"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/step_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/white_soft"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/step_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_glass_icon"
        android:contentDescription="@null"
        android:padding="9dp" />
</LinearLayout>
