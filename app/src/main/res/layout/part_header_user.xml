<?xml version="1.0" encoding="utf-8"?>
<!-- Green header with the member: logo, name, number + status pill, light/dark button. Home and Profile use it. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hero"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_hero"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_logo_clip"
        android:clipToOutline="true"
        android:contentDescription="ViewGrow"
        android:scaleType="centerCrop"
        android:src="@drawable/viewgrow_logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:tag="bold"
            android:textColor="@color/white"
            android:textSize="18sp" />
        <!-- Number and status pill share one line, so the pill reads as part of the identity. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/user_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white_soft"
                android:textSize="12.5sp" />
            <TextView
                android:id="@+id/badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge_glass"
                android:drawablePadding="5dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="9dp"
                android:paddingBottom="3dp"
                android:singleLine="true"
                android:tag="semibold"
                android:textColor="@color/white"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/theme_btn"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_icon_circle"
        android:clickable="true"
        android:contentDescription="Switch between light and dark"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_moon" />
</LinearLayout>
