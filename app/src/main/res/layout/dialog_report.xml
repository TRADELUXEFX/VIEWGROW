<?xml version="1.0" encoding="utf-8"?>
<!-- Report sheet (ReportSheet.kt), design A: a bottom pop-up over History. Title and "They won't know it was you" with a
     close (×), one clean column of reasons (icon, label, round tick; rows are added in code), the "Also remove them from my
     phone" switch (on by default), then Report and the "Only remove from my phone (no report)" link. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="22dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_grab" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rp_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:tag="bold"
                android:textColor="@color/dark"
                android:textSize="18sp" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="5dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/muted" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="They won’t know it was you"
                    android:textColor="@color/muted"
                    android:textSize="12.5sp" />
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:id="@+id/rp_back"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_close_circle"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:padding="9dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text2" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rp_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/rp_block_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_toggle_row"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Also remove them from my phone"
            android:textColor="@color/dark"
            android:textSize="14sp" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/rp_block"
            style="@style/SettingSwitch"
            android:checked="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/rp_ok"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:alpha="0.5"
        android:background="@drawable/bg_pill_red"
        android:clickable="true"
        android:drawablePadding="8dp"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="50dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:tag="semibold"
        android:text="Report"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/rp_only_remove"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minHeight="44dp"
        android:tag="semibold"
        android:text="Only remove from my phone (no report)"
        android:textColor="@color/green_text"
        android:textSize="14sp" />
</LinearLayout>
