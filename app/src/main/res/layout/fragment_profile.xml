<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Green header: "Profile" on the left, then the light/dark button and Log out on the right. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="24dp"
        android:paddingEnd="22dp"
        android:paddingBottom="26dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:tag="extrabold"
            android:text="Profile"
            android:textColor="@color/white"
            android:textSize="26sp" />
        <ImageView
            android:id="@+id/profile_theme_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_icon_circle"
            android:clickable="true"
            android:contentDescription="Switch between light and dark"
            android:focusable="true"
            android:padding="11dp"
            android:src="@drawable/ic_moon" />
        <TextView
            android:id="@+id/btn_logout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_glass"
            android:clickable="true"
            android:focusable="true"
            android:drawablePadding="8dp"
            android:drawableStart="@drawable/ic_logout"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="10dp"
            android:tag="bold"
            android:text="Log out"
            android:textColor="@color/white"
            android:textSize="13.5sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="90dp"
        android:scrollbars="none">

        <!-- Settings laid out the way VG Reshare does it: section labels, one card per setting, title with a line under it, switch on the end. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="22dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <TextView style="@style/SectionLabel" android:layout_marginTop="0dp" android:text="SYNC" />

            <!-- Add new contacts every: its own card, no title (the SYNC label above already says it), just the tip line and the four choices. The chosen one is filled green. -->
            <LinearLayout
                android:id="@+id/row_interval"
                style="@style/SettingRow"
                android:orientation="vertical"
                android:gravity="start">
                <TextView style="@style/SettingSub" android:text="How often the app checks for new contacts." />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_seg_track"
                    android:orientation="horizontal"
                    android:padding="4dp">
                    <TextView
                        android:id="@+id/seg_1"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:tag="semibold"
                        android:text="1h"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/seg_6"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:tag="semibold"
                        android:text="6h"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/seg_12"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:tag="semibold"
                        android:text="12h"
                        android:textSize="13sp" />
                    <TextView
                        android:id="@+id/seg_24"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingTop="10dp"
                        android:paddingBottom="10dp"
                        android:tag="semibold"
                        android:text="24h"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/SettingRow">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/SettingTitle" android:text="Pause syncing" />
                    <TextView style="@style/SettingSub" android:text="Contacts wait until you turn this off." />
                </LinearLayout>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/sw_pause"
                    style="@style/SettingSwitch" />
            </LinearLayout>


            <TextView style="@style/SectionLabel" android:text="PURCHASES" />

            <LinearLayout
                android:id="@+id/row_purchases"
                style="@style/SettingRow"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingTitle" android:layout_width="0dp" android:layout_weight="1" android:text="Purchase history" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <TextView style="@style/SectionLabel" android:text="SUPPORT" />

            <LinearLayout
                android:id="@+id/row_help"
                style="@style/SettingRow"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingTitle" android:layout_width="0dp" android:layout_weight="1" android:text="Frequently asked questions" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_terms"
                style="@style/SettingRow"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingTitle" android:layout_width="0dp" android:layout_weight="1" android:text="Terms and Conditions" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_privacy"
                style="@style/SettingRow"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingTitle" android:layout_width="0dp" android:layout_weight="1" android:text="Privacy Policy" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_change_phone"
                style="@style/SettingRow"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingTitle" android:layout_width="0dp" android:layout_weight="1" android:text="Change phone number" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/row_delete_account"
                style="@style/SettingRow"
                android:clickable="true"
                android:focusable="true">
                <TextView style="@style/SettingTitle" android:layout_width="0dp" android:layout_weight="1" android:text="Delete my account" />
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <!-- Delete My Contacts. Log out is in the green header. -->
            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_delete"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingTop="15dp"
                android:paddingBottom="15dp"
                android:tag="bold"
                android:text="Delete My Contacts"
                android:textColor="@color/red_dark"
                android:textSize="13.5sp" />


            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
