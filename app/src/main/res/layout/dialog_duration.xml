<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tag="extrabold"
        android:text="Duration"
        android:textColor="@color/dark"
        android:textSize="18sp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="14dp"
        android:text="Contacts received in"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/opt_daily"
        style="@style/DurationOption"
        android:text="Daily" />
    <TextView
        android:id="@+id/opt_weekly"
        style="@style/DurationOption"
        android:text="Weekly" />
    <TextView
        android:id="@+id/opt_monthly"
        style="@style/DurationOption"
        android:text="Monthly" />
    <TextView
        android:id="@+id/opt_all"
        style="@style/DurationOption"
        android:text="All time" />
    <TextView
        android:id="@+id/pick_dates"
        style="@style/DurationOption"
        android:layout_marginBottom="16dp"
        android:text="Pick dates\u2026"
        android:textColor="@color/green_text" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/cancel_btn"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginEnd="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_outline"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:tag="semibold"
            android:text="Reset"
            android:textColor="@color/green_text"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/apply_btn"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_fill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:tag="semibold"
            android:text="Apply"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
