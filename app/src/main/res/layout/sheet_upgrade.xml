<?xml version="1.0" encoding="utf-8"?>
<!-- "Increase my limit" pop-up: opened from the button on Home. Packs are added in code (UpgradeSheet.kt). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:tag="extrabold"
        android:text="Increase my limit"
        android:textColor="@color/dark"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/up_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text2"
        android:textSize="13sp" />

    <!-- What the member is paying for, and why. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_row_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:tag="semibold"
            android:text="What you are buying"
            android:textColor="@color/dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/up_explain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text"
            android:textSize="13sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/up_packs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/up_buy"
        style="@style/AppButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:icon="@drawable/ic_google_play"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        android:text="Buy with Google Play" />

    <TextView
        android:id="@+id/up_later"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_pill_outline"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:tag="semibold"
        android:text="Not now"
        android:textColor="@color/green_text"
        android:textSize="15sp" />
</LinearLayout>
