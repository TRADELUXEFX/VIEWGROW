<?xml version="1.0" encoding="utf-8"?>
<!-- "Increase my contact limit" pop-up: opened from Home, and from the Help page. Packs and facts are added in code (UpgradeSheet.kt). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_sheet_top"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:tag="extrabold"
            android:text="Increase my contact limit"
            android:textColor="@color/dark"
            android:textSize="18sp" />

        <!-- Plain-words summary of what the limit is and what paying does. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_field"
            android:orientation="vertical"
            android:padding="13dp">
            <TextView
                android:id="@+id/up_explain_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/up_explain_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:lineSpacingMultiplier="1.2"
                android:textColor="@color/text"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- How much of the limit is used. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Used so far"
                android:textColor="@color/text2"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/up_used"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:tag="semibold"
                android:textColor="@color/dark"
                android:textSize="12sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/up_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="2dp"
            android:text="CHOOSE HOW MUCH ROOM TO ADD" />

        <LinearLayout
            android:id="@+id/up_packs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- One-time payment reassurance. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:drawableStart="@drawable/ic_check_green"
            android:drawablePadding="8dp"
            android:gravity="center_vertical"
            android:text="One-time payment, not a subscription"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/up_buy"
            style="@style/AppButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:icon="@drawable/ic_google_play"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            android:text="Buy with Google Play" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/up_later"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:tag="semibold"
                android:text="Not now"
                android:textColor="@color/text2"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/up_help"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
        android:minHeight="44dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingEnd="4dp"
                android:tag="semibold"
                android:text="Questions about paying?"
                android:textColor="@color/green_text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
