<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen country page (CountryField.open): green header, floating search, country cards, A to Z strip. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <!-- Header: Back + title, and the search box sitting fully inside the green. -->
    <LinearLayout
        android:id="@+id/country_hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="14dp"
        android:paddingEnd="18dp"
        android:paddingBottom="26dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/country_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_back_circle"
                android:contentDescription="Back"
                android:padding="8dp"
                android:src="@drawable/ic_back" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:tag="bold"
                android:text="Choose your country"
                android:textColor="@color/white"
                android:textSize="22sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/country_search_box"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_country_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="8dp">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_search" />
            <EditText
                android:id="@+id/country_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search country or code"
                android:imeOptions="actionDone"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/white"
                android:textColorHint="#BFD8CA"
                android:textSize="15sp" />
            <ImageView
                android:id="@+id/country_clear"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Clear"
                android:padding="8dp"
                android:src="@drawable/ic_clear"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/country_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:listSelector="@android:color/transparent"
            android:overScrollMode="never"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:scrollbars="none" />
        <TextView
            android:id="@+id/country_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="No country found"
            android:textColor="@color/muted"
            android:textSize="15sp"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/country_rail"
            android:layout_width="24dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical" />
    </FrameLayout>
</LinearLayout>
