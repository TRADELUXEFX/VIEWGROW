<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light only. The admin website inside the app has its own dark mode switch. -->
    <style name="Theme.VGAdmin" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorPrimaryVariant">@color/green_dark</item>
        <item name="colorSecondary">@color/green</item>
        <item name="android:statusBarColor">@color/green</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
    </style>

    <!-- Shown first on launch, like the member app's: the ViewGrow icon in the middle, but on green. -->
    <style name="Theme.VGAdmin.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.VGAdmin</item>
    </style>
</resources>
