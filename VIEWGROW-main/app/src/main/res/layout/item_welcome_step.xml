<?xml version="1.0" encoding="utf-8"?>
<!-- One step on the Welcome screen: numbered dot joined by a line, title, line of text, icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="match_parent">
        <View
            android:id="@+id/step_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:background="@color/welcome_line" />
        <TextView
            android:id="@+id/step_num"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_step_badge"
            android:gravity="center"
            android:tag="extrabold"
            android:textColor="@color/white"
            android:textSize="12sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingBottom="22dp">
        <TextView
            android:id="@+id/step_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:tag="bold"
            android:textColor="@color/dark"
            android:textSize="15sp" />
        <TextView
            android:id="@+id/step_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/muted"
            android:textSize="12.5sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/step_icon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_tint_circle"
        android:contentDescription="@null"
        android:padding="9dp" />
</LinearLayout>
