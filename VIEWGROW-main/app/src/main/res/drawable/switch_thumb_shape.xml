<?xml version="1.0" encoding="utf-8"?>
<!-- Switch thumb: a 24dp circle with a 3dp gap all round, so it always sits fully inside the track. Colour comes from switch_thumb.
     A layer-list, not an inset: a switch treats an inset's gap as optical padding and lets the thumb sit flush
     against the track end, where white on a white card made the toggle look cut off. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="3dp"
        android:top="3dp"
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="oval">
            <size android:width="24dp" android:height="24dp" />
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</layer-list>
